{
  "name": "ruphak-varmaa-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && node scripts/build-corpus.ts --out public/retrieval && vite",
    "build": "tsc -b && node scripts/copy-ort.mjs && node scripts/build-corpus.ts --out public/retrieval && vite build && vite build --ssr src/prerender/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.mjs && node scripts/embed-corpus.mjs && node scripts/check-budgets.mjs",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "csp:hash": "node scripts/csp-hash.mjs",
    "ort:copy": "node scripts/copy-ort.mjs",
    "postinstall": "node scripts/copy-ort.mjs",
    "preview": "vite preview",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/big-shoulders": "5.3.0",
    "@fontsource-variable/big-shoulders-stencil": "5.3.0",
    "@fontsource-variable/doto": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@gsap/react": "2.1.2",
    "acorn": "8.18.0",
    "gsap": "3.15.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "packageManager": "pnpm@11.8.0"
}
